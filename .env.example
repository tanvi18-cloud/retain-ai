# =============================================================================
# RetainAI — environment template (copy to .env at repository root)
# Synthetic data only. Do not commit real credentials or customer data.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Local dev: APP_ENV=development, DEBUG=true
# Docker:    APP_ENV=development, DEBUG=false (set in docker-compose.yml)
APP_NAME=RetainAI
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
# Local backend (uvicorn): 8001 recommended to avoid Docker port clash
# Docker backend:          8000 (mapped to host 8000)
API_PORT=8001

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local non-Docker: sqlite:///./retain_ai.db (relative to backend/)
# Docker:           sqlite:////data/retain_ai.db (mounted volume retainai_data)
DATABASE_URL=sqlite:///./retain_ai.db

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Local Vite dev server: http://localhost:5173
# Docker Nginx:          http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173

# Frontend build-time variables live in frontend/.env (see frontend/.env.example):
#   VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1
#   VITE_WS_BASE_URL=ws://127.0.0.1:8001/ws/alerts
# Docker build args (docker-compose.yml):
#   VITE_API_BASE_URL=http://localhost:8080/api/v1
#   VITE_WS_BASE_URL=ws://localhost:8080/ws/alerts

# -----------------------------------------------------------------------------
# Qwen (local LLM)
# -----------------------------------------------------------------------------
# MOCK_LLM_MODE=true runs without a live Qwen endpoint (recommended for demos).
# Docker Qwen on host: QWEN_BASE_URL=http://host.docker.internal:9000/v1
MOCK_LLM_MODE=true
QWEN_BASE_URL=http://localhost:9000/v1
QWEN_API_KEY=not-required-for-local
QWEN_MODEL=Qwen/Qwen3-8B
QWEN_TEMPERATURE=0.1
QWEN_TIMEOUT_SECONDS=60
QWEN_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Agents (CrewAI)
# -----------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=4
AGENT_VERBOSE=false

# -----------------------------------------------------------------------------
# Queue (async event processing)
# -----------------------------------------------------------------------------
QUEUE_WORKER_COUNT=1
EVENT_MAX_RETRIES=2
EVENT_SHUTDOWN_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Alerts (priority thresholds)
# -----------------------------------------------------------------------------
ALERT_PRIORITY_THRESHOLD=70
REVIEW_PRIORITY_THRESHOLD=50
RUN_FULL_CREW_MIN_PRIORITY=50
CREATE_ALERT_MIN_PRIORITY=50
SEND_EMAIL_MIN_PRIORITY=70
PERSIST_NO_ACTION_RECOMMENDATIONS=true

# -----------------------------------------------------------------------------
# Email (SMTP — Mailpit for local demo)
# -----------------------------------------------------------------------------
# Mailpit web UI: http://localhost:8025
# Mailpit SMTP:   localhost:1025 (Docker service name: mailpit)
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=retainai@example.local
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10
RM_EMAIL=rm@example.local

# -----------------------------------------------------------------------------
# Chat (RM Copilot)
# -----------------------------------------------------------------------------
CHAT_HISTORY_ENABLED=true
CHAT_MAX_HISTORY_MESSAGES=12
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_MAX_TOOL_CALLS=6
CHAT_TIMEOUT_SECONDS=45
CHAT_CONVERSATION_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Simulator (data freshness thresholds, hours)
# -----------------------------------------------------------------------------
CORE_BANKING_STALE_HOURS=72
CREDIT_PROFILE_STALE_HOURS=168
BUREAU_TRIGGER_STALE_HOURS=720
TRANSACTION_FEATURE_STALE_HOURS=48

# -----------------------------------------------------------------------------
# Security / scoring weights
# -----------------------------------------------------------------------------
CHURN_PRIORITY_WEIGHT=0.55
VALUE_PRIORITY_WEIGHT=0.45
DECISION_MONITOR_THRESHOLD=30
WEBSOCKET_HEARTBEAT_SECONDS=30

# -----------------------------------------------------------------------------
# Docker (reference — primary values set in docker-compose.yml)
# -----------------------------------------------------------------------------
# Services: backend:8000, frontend:8080, mailpit:8025 (UI) / 1025 (SMTP)
# Volume:    retainai_data mounted at /data in backend container
# Network:   retainai_network
# Start:     docker compose up -d
# Reset DB:  docker compose down -v
