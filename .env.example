APP_NAME=RetainAI
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./retain_ai.db
FRONTEND_ORIGIN=http://localhost:5173

MOCK_LLM_MODE=true
QWEN_BASE_URL=http://localhost:9000/v1
QWEN_API_KEY=not-required-for-local
QWEN_MODEL=Qwen/Qwen3-8B
QWEN_TEMPERATURE=0.1
QWEN_TIMEOUT_SECONDS=60
QWEN_MAX_RETRIES=2
AGENT_MAX_ITERATIONS=4
AGENT_VERBOSE=false

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=retainai@example.local
RM_EMAIL=rm@example.local

ALERT_PRIORITY_THRESHOLD=70
REVIEW_PRIORITY_THRESHOLD=50
CHURN_PRIORITY_WEIGHT=0.55
VALUE_PRIORITY_WEIGHT=0.45
DECISION_MONITOR_THRESHOLD=30
PERSIST_NO_ACTION_RECOMMENDATIONS=true
RUN_FULL_CREW_MIN_PRIORITY=50
CREATE_ALERT_MIN_PRIORITY=50
SEND_EMAIL_MIN_PRIORITY=70
QUEUE_WORKER_COUNT=1
EVENT_MAX_RETRIES=2
EVENT_SHUTDOWN_TIMEOUT_SECONDS=10
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10
WEBSOCKET_HEARTBEAT_SECONDS=30

CORE_BANKING_STALE_HOURS=72
CREDIT_PROFILE_STALE_HOURS=168
BUREAU_TRIGGER_STALE_HOURS=720
TRANSACTION_FEATURE_STALE_HOURS=48
